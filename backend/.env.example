DJANGO_SECRET_KEY=django-insecure-texora-ai-foundation-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Engine: 'sqlite' or 'postgresql'
DB_ENGINE=sqlite

# PostgreSQL Configuration
DB_NAME=texora_db
DB_USER=texora_user
DB_PASSWORD=texora_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:50000,http://127.0.0.1:50000

# LLM Provider Configuration for Autonomous AI Agents
# Providers: 'gemini', 'openai', 'anthropic', 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=2
