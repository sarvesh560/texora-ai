# ==========================================
# TEXORA AI - ROOT ENVIRONMENT CONFIGURATION
# ==========================================

# Django Settings
DJANGO_SECRET_KEY=django-insecure-texora-ai-foundation-secret-key-change-in-production-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Engine: 'sqlite' (local development default) or 'postgresql'
DB_ENGINE=sqlite

# PostgreSQL Configuration (used when DB_ENGINE=postgresql)
DB_NAME=texora_db
DB_USER=texora_user
DB_PASSWORD=texora_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080,http://localhost:50000,http://127.0.0.1:50000

# Frontend Base API URL (for Flutter)
API_BASE_URL=http://127.0.0.1:8000/api/v1
